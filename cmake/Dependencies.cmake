# Root variables must be established in every caller directory scope.
get_filename_component(SDK_OPEN_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SDK_OPEN_SOURCE_DIR "${SDK_OPEN_SOURCE_ROOT}")
if(NOT SDK_OPEN_HOST_SOURCE_ROOT AND DEFINED ENV{SDK_OPEN_HOST_SOURCE_ROOT})
    set(SDK_OPEN_HOST_SOURCE_ROOT "$ENV{SDK_OPEN_HOST_SOURCE_ROOT}")
endif()
if(NOT SDK_OPEN_THIRD_PARTY_ROOT AND DEFINED ENV{SDK_OPEN_THIRD_PARTY_ROOT})
    set(SDK_OPEN_THIRD_PARTY_ROOT "$ENV{SDK_OPEN_THIRD_PARTY_ROOT}")
endif()
# The real providers reuse CapEditor modules; the mock runtime does not require them.
if(NOT SDK_OPEN_HOST_SOURCE_ROOT)
    get_filename_component(_sdk_host_candidate "${SDK_OPEN_SOURCE_ROOT}/../.." ABSOLUTE)
    if(EXISTS "${_sdk_host_candidate}/src/module/CMakeLists.txt")
        set(SDK_OPEN_HOST_SOURCE_ROOT "${_sdk_host_candidate}")
    endif()
endif()
set(SDK_OPEN_HOST_SOURCE_ROOT "${SDK_OPEN_HOST_SOURCE_ROOT}" CACHE PATH "CapEditor shared source root")
if(NOT SDK_OPEN_THIRD_PARTY_ROOT AND SDK_OPEN_HOST_SOURCE_ROOT)
    set(SDK_OPEN_THIRD_PARTY_ROOT "${SDK_OPEN_HOST_SOURCE_ROOT}/third_party_repo")
endif()
set(SDK_OPEN_THIRD_PARTY_ROOT "${SDK_OPEN_THIRD_PARTY_ROOT}" CACHE PATH "Shared native dependency root")
if(SDK_OPEN_HOST_SOURCE_ROOT)
    set(CZUR_SOURCE_ROOT "${SDK_OPEN_HOST_SOURCE_ROOT}")
endif()
if(SDK_OPEN_THIRD_PARTY_ROOT)
    set(CZUR_THIRD_PARTY_ROOT "${SDK_OPEN_THIRD_PARTY_ROOT}")
endif()
