#!/bin/sh
set -e

case "$1" in
    remove|purge)
        systemctl disable sdk-open.service >/dev/null 2>&1 || true
        systemctl daemon-reload >/dev/null 2>&1 || true

        tls_dir=/etc/czur/sdk-open/tls
        managed_root_path="$tls_dir/local-runtime-root-ca.crt"
        state_path="$tls_dir/tls-state.json"
        trusted_root_path=/usr/local/share/ca-certificates/local-runtime-root-ca.crt
        legacy_root_certificate_sha256=4405b523122776ada5d3559bad492689b6edf161f9186e6893c0a5700575793c
        remove_trusted_root=false
        if [ -e "$trusted_root_path" ] && command -v sha256sum >/dev/null 2>&1; then
            trusted_root_sha256=$(sha256sum "$trusted_root_path" | awk '{print $1}')
            if [ "$trusted_root_sha256" = "$legacy_root_certificate_sha256" ]; then
                remove_trusted_root=true
            elif [ -e "$managed_root_path" ] && [ -e "$state_path" ] &&
                 grep -Eq '"mode"[[:space:]]*:[[:space:]]*"managed"' "$state_path" &&
                 [ "$(sha256sum "$managed_root_path" | awk '{print $1}')" = \
                   "$trusted_root_sha256" ]; then
                remove_trusted_root=true
            fi
        fi

        rm -rf /opt/apps/sdk-open
        rm -rf /etc/czur/sdk-open
        if [ "$remove_trusted_root" = true ]; then
            rm -f "$trusted_root_path"
        fi
        if [ "$remove_trusted_root" = true ] &&
           command -v update-ca-certificates >/dev/null 2>&1; then
            update-ca-certificates >/dev/null 2>&1 || true
        fi
        if [ -f /etc/hosts ]; then
            sed -i '\|# Local SDK runtime$|d' /etc/hosts
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac

exit 0
