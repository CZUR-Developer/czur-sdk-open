# SDK Open 本机 TLS 默认配置。环境变量可覆盖同名配置。
SDK_TLS_ENABLED=1
SDK_TLS_BIND_HOST=127.0.0.1
SDK_TLS_CERT_FILE=/etc/czur/sdk-open/tls/sdk-runtime.localhost.fullchain.pem
SDK_TLS_KEY_FILE=/etc/czur/sdk-open/tls/sdk-runtime.localhost.key.pem
SDK_ASSET_BASE_URL=https://sdk-runtime.localhost:18082
SDK_ASSET_HTTPS_PORT=18082
SDK_COMMAND_WSS_PORT=18090
SDK_VIDEO_WSS_PORT=18091
