#!/bin/bash
set -euo pipefail

CANDIDATE_VERSION="@HELPER_VERSION@"
HELPER_PATH="/Library/PrivilegedHelperTools/com.czur.device-helper"

numeric_version_at_least() {
    /usr/bin/awk -v installed="$1" -v required="$2" '
        BEGIN {
            if (installed !~ /^[0-9]+([.][0-9]+)*$/ ||
                required !~ /^[0-9]+([.][0-9]+)*$/) {
                exit 2
            }
            installed_count = split(installed, installed_parts, ".")
            required_count = split(required, required_parts, ".")
            count = installed_count > required_count ? installed_count : required_count
            for (part_index = 1; part_index <= count; ++part_index) {
                installed_part = part_index <= installed_count ? installed_parts[part_index] + 0 : 0
                required_part = part_index <= required_count ? required_parts[part_index] + 0 : 0
                if (installed_part > required_part) exit 0
                if (installed_part < required_part) exit 1
            }
            exit 0
        }
    '
}

installed_version=""
installed_signature_valid=0
if [[ -f "${HELPER_PATH}" ]]; then
    installed_version="$(
        /usr/bin/plutil -p "${HELPER_PATH}" 2>/dev/null |
            /usr/bin/sed -n 's/.*"CFBundleVersion" => "\([0-9.][0-9.]*\)".*/\1/p' |
            /usr/bin/head -1 || true
    )"
    if /usr/bin/codesign --verify --strict "${HELPER_PATH}" 2>/dev/null; then
        installed_signature_valid=1
    fi
fi

# helper 是 CapEditor 与 SDK Open 共用的系统服务。未来版本保证向下兼容，
# 所以安装旧 SDK Open 时不能停止已经存在的同版本或更高版本 helper。
if [[ "${installed_signature_valid}" -eq 1 && -n "${installed_version}" ]] &&
   numeric_version_at_least "${installed_version}" "${CANDIDATE_VERSION}"; then
    exit 0
fi

# payload 先安装到隔离的 staging 目录，不会直接覆盖共享 helper。只有缺失、
# 版本无效或版本低于本安装包最低要求时才停止旧服务，postinstall 再替换。
/bin/launchctl bootout system/com.czur.device-helper 2>/dev/null || true
exit 0
