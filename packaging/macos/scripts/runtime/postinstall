#!/bin/bash
set -euo pipefail

RUNTIME_DIR="/Library/CZUR/sdk-open"
LAUNCH_AGENT_PLIST="/Library/LaunchAgents/com.czur.sdk-open.plist"
ROOT_CA="${RUNTIME_DIR}/tls/local-runtime-root-ca.crt"
SERVER_CERT="${RUNTIME_DIR}/tls/sdk-runtime.localhost.fullchain.pem"
TLS_DIR="${RUNTIME_DIR}/tls"
SYSTEM_KEYCHAIN="/Library/Keychains/System.keychain"
TRUST_INSTALL_TIMEOUT_SECONDS="${SDK_OPEN_TRUST_INSTALL_TIMEOUT_SECONDS:-30}"
HOSTS_FILE="/etc/hosts"
RUNTIME_HOST="sdk-runtime.localhost"
HOSTS_MARKER="CZUR SDK Open managed host"
MANAGED_HOSTS_LINE="127.0.0.1 ${RUNTIME_HOST} # ${HOSTS_MARKER}"
HOSTS_TEMP=""

cleanup_hosts_temp() {
    if [[ -n "${HOSTS_TEMP}" ]]; then
        rm -f "${HOSTS_TEMP}"
    fi
}

trap cleanup_hosts_temp EXIT

case "${TRUST_INSTALL_TIMEOUT_SECONDS}" in
    ''|*[!0-9]*)
        echo "SDK_OPEN_TRUST_INSTALL_TIMEOUT_SECONDS must be a positive integer" >&2
        exit 1
        ;;
esac
if [[ "${TRUST_INSTALL_TIMEOUT_SECONDS}" -le 0 ]]; then
    echo "SDK_OPEN_TRUST_INSTALL_TIMEOUT_SECONDS must be a positive integer" >&2
    exit 1
fi

root_ca_sha256() {
    /usr/bin/openssl x509 -in "${ROOT_CA}" -outform der 2>/dev/null |
        /usr/bin/shasum -a 256 |
        /usr/bin/awk '{ print toupper($1) }'
}

system_keychain_trusts_root_ca() {
    local expected_sha256
    expected_sha256="$(root_ca_sha256)"
    [[ -n "${expected_sha256}" ]] || return 1

    /usr/bin/security find-certificate -a -Z -c "Local Runtime Root CA" \
        "${SYSTEM_KEYCHAIN}" 2>/dev/null |
        /usr/bin/awk '/SHA-256 hash:/ { print toupper($3) }' |
        /usr/bin/grep -Fxq "${expected_sha256}" || return 1

    # A certificate item can exist without an administrator SSL trust setting.
    /usr/bin/security verify-cert -c "${ROOT_CA}" -p ssl >/dev/null 2>&1
}

install_root_ca_trust() {
    local security_pid watchdog_pid status timed_out
    timed_out="$(mktemp /tmp/czur-sdk-open-trust-timeout.XXXXXX)"
    rm -f "${timed_out}"

    echo "Installing Local Runtime Root CA trust in the System keychain."
    set +e
    /usr/bin/security add-trusted-cert \
        -d -r trustRoot -p ssl -k "${SYSTEM_KEYCHAIN}" "${ROOT_CA}" &
    security_pid=$!
    (
        sleep "${TRUST_INSTALL_TIMEOUT_SECONDS}"
        if kill -0 "${security_pid}" 2>/dev/null; then
            : > "${timed_out}"
            kill -TERM "${security_pid}" 2>/dev/null || true
            sleep 2
            kill -KILL "${security_pid}" 2>/dev/null || true
        fi
    ) &
    watchdog_pid=$!
    wait "${security_pid}"
    status=$?
    kill "${watchdog_pid}" 2>/dev/null || true
    wait "${watchdog_pid}" 2>/dev/null || true
    set -e

    if [[ -e "${timed_out}" ]]; then
        rm -f "${timed_out}"
        echo "Timed out after ${TRUST_INSTALL_TIMEOUT_SECONDS}s while installing Local Runtime Root CA trust." >&2
        echo "Preinstall the certificate through Keychain Access, MDM, or a configuration profile, then retry." >&2
        return 1
    fi
    rm -f "${timed_out}"
    if [[ "${status}" -ne 0 ]]; then
        echo "Unable to install Local Runtime Root CA trust non-interactively (security exit ${status})." >&2
        echo "Preinstall the certificate through Keychain Access, MDM, or a configuration profile, then retry." >&2
        return "${status}"
    fi
}

hosts_has_runtime_mapping() {
    awk -v runtime_host="${RUNTIME_HOST}" '
        /^[[:space:]]*#/ { next }
        NF >= 2 {
            for (i = 2; i <= NF; i++) {
                if ($i ~ /^#/) break
                if (tolower($i) == tolower(runtime_host)) found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    ' "${HOSTS_FILE}"
}

install_runtime_host_mapping() {
    if hosts_has_runtime_mapping; then
        return
    fi

    HOSTS_TEMP="$(mktemp "${HOSTS_FILE}.czur-sdk-open.XXXXXX")"
    awk -v managed_line="${MANAGED_HOSTS_LINE}" '$0 != managed_line' \
        "${HOSTS_FILE}" > "${HOSTS_TEMP}"
    printf '\n%s\n' "${MANAGED_HOSTS_LINE}" >> "${HOSTS_TEMP}"
    /bin/cp "${HOSTS_TEMP}" "${HOSTS_FILE}"
    rm -f "${HOSTS_TEMP}"
    HOSTS_TEMP=""
}

migrate_legacy_tls_defaults() {
    # Pre-rotation releases shipped a public CA and a shared leaf pair, but
    # never the CA private key. Only remove those exact known defaults;
    # managed installations and customer replacements must be preserved.
    [[ ! -e "${TLS_DIR}/tls-state.json" ]] || return 0
    [[ ! -e "${TLS_DIR}/local-runtime-root-ca.key.pem" ]] || return 0

    local root_hash certificate_hash private_key_hash
    if [[ -f "${ROOT_CA}" ]]; then
        root_hash="$(/usr/bin/shasum -a 256 "${ROOT_CA}" | /usr/bin/awk '{ print $1 }')"
        if [[ "${root_hash}" != "4405b523122776ada5d3559bad492689b6edf161f9186e6893c0a5700575793c" ]]; then
            return 0
        fi
    fi
    if [[ -f "${SERVER_CERT}" && -f "${TLS_DIR}/sdk-runtime.localhost.key.pem" ]]; then
        certificate_hash="$(/usr/bin/shasum -a 256 "${SERVER_CERT}" | /usr/bin/awk '{ print $1 }')"
        private_key_hash="$(/usr/bin/shasum -a 256 "${TLS_DIR}/sdk-runtime.localhost.key.pem" | /usr/bin/awk '{ print $1 }')"
        case "${certificate_hash}:${private_key_hash}" in
            6519c52926b4cc3399b242dd44077f38b39457e080c56b6fe2f09a8af92ad32e:ceae324c3be1d43a19ea983c8bbd2f757001486265c7a6596ece42134f01cf11|\
            3b70d132fef144f6da10e732c8265029794757f1ebb258c9cb5541e4485b18b0:ceae324c3be1d43a19ea983c8bbd2f757001486265c7a6596ece42134f01cf11)
                rm -f "${SERVER_CERT}" "${TLS_DIR}/sdk-runtime.localhost.key.pem"
                echo "Migrating packaged legacy SDK Open TLS credentials to a machine-local CA."
                ;;
        esac
    fi
    # A customer leaf pair can coexist with the old packaged root. Removing
    # this known public root lets provisioning preserve that pair as custom.
    rm -f "${ROOT_CA}"
}

chown -R root:wheel "${RUNTIME_DIR}"
chmod 755 "${RUNTIME_DIR}" "${RUNTIME_DIR}/sdk_open_app"
chmod 644 "${LAUNCH_AGENT_PLIST}"
rm -f "${RUNTIME_DIR}/sdk-open-launcher.sh"

# Generate a per-install CA/key pair on the machine. The private key is not
# shipped in the PKG; it is created by the signed runtime using OpenSSL and is
# later copied into the logged-in user's protected runtime directory.
migrate_legacy_tls_defaults
if [[ ! -e "${TLS_DIR}/tls-state.json" ]]; then
    "${RUNTIME_DIR}/sdk_open_app" --provision-tls --provision-tls-dir "${TLS_DIR}"
elif ! /usr/bin/grep -Fq '"mode":"custom"' "${TLS_DIR}/tls-state.json"; then
    # ditto may have replaced the packaged leaf files during an upgrade; renew
    # only the leaf under the already trusted local CA.
    "${RUNTIME_DIR}/sdk_open_app" --renew-tls --provision-tls-dir "${TLS_DIR}"
else
    echo "Preserving customer-provided SDK Open TLS certificate pair."
fi
chmod 640 "${TLS_DIR}/local-runtime-root-ca.key.pem"
chmod 644 "${TLS_DIR}/tls-state.json"

if /usr/bin/grep -Fq '"mode":"custom"' "${TLS_DIR}/tls-state.json"; then
    echo "Customer-provided SDK Open TLS certificate pair is active; skipping CZUR root trust import."
elif system_keychain_trusts_root_ca; then
    echo "Local Runtime Root CA is already trusted for SSL; skipping trust import."
else
    install_root_ca_trust
fi
if ! /usr/bin/grep -Fq '"mode":"custom"' "${TLS_DIR}/tls-state.json" && ! system_keychain_trusts_root_ca; then
    echo "Local Runtime Root CA was not installed with working System keychain SSL trust." >&2
    exit 1
fi
# Validate native browser requirements too: OpenSSL/curl with --cacert does not
# enforce macOS's 825-day maximum for a server certificate under a private CA.
if ! /usr/bin/grep -Fq '"mode":"custom"' "${TLS_DIR}/tls-state.json" && ! /usr/bin/security verify-cert -c "${SERVER_CERT}" -p ssl -s "${RUNTIME_HOST}" >/dev/null; then
    echo "SDK Open server certificate is not valid for native macOS HTTPS/WSS clients." >&2
    exit 1
fi
install_runtime_host_mapping

CONSOLE_USER="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
if [[ -n "${CONSOLE_USER}" && "${CONSOLE_USER}" != "root" && "${CONSOLE_USER}" != "loginwindow" ]]; then
    CONSOLE_UID="$(id -u "${CONSOLE_USER}")"
    /bin/chmod +a "${CONSOLE_USER} allow read" "${TLS_DIR}/local-runtime-root-ca.key.pem" 2>/dev/null || true
    launchctl bootstrap "gui/${CONSOLE_UID}" "${LAUNCH_AGENT_PLIST}" 2>/dev/null || true
    launchctl kickstart -k "gui/${CONSOLE_UID}/com.czur.sdk-open" 2>/dev/null || true
fi
exit 0
